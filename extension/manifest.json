{
  "manifest_version": 3,
  "name": "PhishGuard — Real-Time Phishing Intelligence",
  "version": "1.0.0",
  "description": "Intercepts zero-day credential harvesting, homoglyph domain spoofing, and malicious link redirections.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PhishGuard Threat Inspector"
  }
}

